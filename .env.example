# ShopLocal UG - Environment Configuration Template
# Copy this file to .env and fill in values as needed.

# Database (PostgreSQL / Cloud SQL)
# When running with Cloud SQL, provide the connection string
DATABASE_URL=

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-this-to-a-secure-random-secret-key

# ShopLocal Marketplace Admin IDs
SHOPLOCAL_ADMIN_USER_ID=
BOOST_ADMIN_FIREBASE_UID=

# Vercel Blob Storage (Image uploads)
# If omitted, uploads fall back to inline data URLs
BLOB_READ_WRITE_TOKEN=

# Pesapal Payment Gateway (Uganda)
# Aggregates MTN Mobile Money, Airtel Money, Visa & Mastercard in Uganda
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_URL=http://localhost:3000/api/payments/pesapal/ipn
PESAPAL_CALLBACK_URL=http://localhost:3000/

# Gemini API (Server-side)
GEMINI_API_KEY=
